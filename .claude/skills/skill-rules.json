{
  "version": "1.0",
  "description": "Base skill activation triggers. Add project-specific skills as needed.",
  "skills": {
    "skill-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Meta-skill for creating and managing Claude Code skills",
      "promptTriggers": {
        "keywords": [
          "skill system",
          "create skill",
          "add skill",
          "skill triggers",
          "skill rules",
          "hook system",
          "skill development",
          "skill-rules.json"
        ],
        "intentPatterns": [
          "(how do|how does|explain).*?skill",
          "(create|add|modify|build).*?skill",
          "skill.*?(work|trigger|activate|system)"
        ]
      }
    },
    "agent-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Meta-skill for creating and managing Claude Code agents",
      "promptTriggers": {
        "keywords": [
          "agent system",
          "create agent",
          "add agent",
          "sub-agent",
          "subagent",
          "multi-agent",
          "agent workflow",
          "agent chaining",
          "Task tool",
          "model selection",
          "haiku",
          "sonnet",
          "opus"
        ],
        "intentPatterns": [
          "(how do|how does|explain).*?agent",
          "(create|add|modify|build).*?agent",
          "agent.*?(work|trigger|activate|pattern)",
          "(parallel|sequential).*?agent",
          "(when|which).*?model"
        ]
      }
    },
    "coding-standards": {
      "type": "quality",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "TypeScript coding standards and best practices",
      "promptTriggers": {
        "keywords": [
          "code quality",
          "standards",
          "naming",
          "TypeScript",
          "best practices",
          "refactor",
          "clean code"
        ],
        "intentPatterns": [
          "(improve|refactor).*?(code|structure)",
          "(review|check).*?(quality|standards)"
        ]
      }
    },
    "tdd-workflow": {
      "type": "methodology",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Test-driven development with 80% minimum coverage",
      "promptTriggers": {
        "keywords": [
          "TDD",
          "test driven",
          "write test",
          "test first",
          "test coverage",
          "testing"
        ],
        "intentPatterns": [
          "(implement|add|create).*?feature",
          "(fix|resolve).*?bug",
          "test.*?(first|driven)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*.test.ts",
          "**/*.spec.ts",
          "**/__tests__/**",
          "**/tests/**"
        ]
      }
    },
    "using-git-worktrees": {
      "type": "methodology",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Create isolated git worktrees for feature work",
      "promptTriggers": {
        "keywords": [
          "worktree",
          "git worktree",
          "isolated workspace",
          "feature branch",
          "new feature",
          "start feature",
          "implement feature"
        ],
        "intentPatterns": [
          "(create|setup|start).*?(worktree|isolated|workspace)",
          "(implement|build|add|create).*?(feature|endpoint|component)",
          "(begin|start).*?(feature|work|implementation)",
          "ralph-dev",
          "dev-docs"
        ]
      }
    }
  },
  "notes": {
    "setup": "Universal base configuration with 4 skills. Add project-specific skills from optional-components/skills/ as needed.",
    "enforcement_types": {
      "suggest": "Skill suggestion appears but doesn't block execution",
      "block": "Requires skill to be used before proceeding (guardrail)",
      "warn": "Shows warning but allows proceeding"
    },
    "priority_levels": {
      "critical": "Highest - Always trigger when matched",
      "high": "Important - Trigger for most matches",
      "medium": "Moderate - Trigger for clear matches",
      "low": "Optional - Trigger only for explicit matches"
    },
    "customization": {
      "pathPatterns": "Update to match your project structure",
      "keywords": "Add domain-specific terms",
      "intentPatterns": "Use regex for user intent matching"
    }
  }
}
