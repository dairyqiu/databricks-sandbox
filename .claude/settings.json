{
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "permissions": {
    "allow": [
      "Edit:*",
      "Write:*",
      "MultiEdit:*",
      "NotebookEdit:*",
      "WebSearch",
      "WebFetch",
      "mcp__*",

      "Bash(npm run *)",
      "Bash(bun *)",
      "Bash(npx *)",

      "Bash(uv *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(pip install *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",

      "Bash(gh auth status*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checkout*)",
      "Bash(gh issue *)",
      "Bash(gh api *)",

      "Bash(npm install *)",
      "Bash(bun install *)",
      "Bash(cp */.env *)",
      "Bash(cp .env *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(sleep *)",

      "Bash(databricks *)",
      "Bash(mcp-cli *)",
      "Bash(jq *)",
      "Bash(curl *api.databricks.com*)",
      "Bash(curl *localhost*)",
      "Bash(curl *127.0.0.1*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Bash(curl *pastebin*)",
      "Bash(curl *transfer.sh*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/skill-activation-prompt.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use-tracker.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/plugins/ralph-wiggum/hooks/stop-hook.sh"
          }
        ]
      }
    ]
  }
}
